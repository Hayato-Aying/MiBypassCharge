<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.changxyz.mibypasscharge.tile"
    android:versionCode="10820"
    android:versionName="1.8.2">

    <!-- 充电提醒由本 App 发出（带 App 图标）。Android 13+ 还必须拿到运行时权限，
         模块安装脚本会用 `pm grant` 直接授予，失败时用户可在系统设置里手动开。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 这个 Activity 就是模块 WebUI 的宿主：桌面图标、磁贴长按，两个入口都到它。
             长按磁贴走 QS_TILE_PREFERENCES —— TileService 没有 onLongClick，
             系统只认这个 action（android-35 的桩里也确认没有别的钩子）。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".BypassTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 守护进程（root）用显式广播把提醒交给本 App 发：
             am broadcast 点名 com.changxyz.mibypasscharge.tile/.NotifyReceiver，
             再用 es 参数带 text 文本。
             不挂 intent-filter —— 只允许点名调用，避免被任意应用触发。 -->
        <receiver
            android:name=".NotifyReceiver"
            android:exported="true">
        </receiver>

        <!-- App 落到 cached 之后点名广播会被系统吞掉（记录成 delivered 但不执行），
             所以守护优先用 am start-service 显式拉起这个 Service 来发通知。 -->
        <service
            android:name=".NotifyService"
            android:exported="true" />

    </application>
</manifest>
